
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>One day a surprise</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 25px 15px;
  background: #eff9f3;
  font-family: Arial, sans-serif;
  color: #176c50;
}

header {
  text-align: center;
  padding: 25px 5px;
}

h1 {
  font-family: Georgia, serif;
  font-size: 42px;
  margin: 12px 0;
}

header p {
  color: #56836e;
}

.grid {
  max-width: 600px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 85px;
  grid-auto-flow: dense;
  gap: 9px;
}

.door {
  border: 3px solid #d0e8dc;
  border-radius: 13px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 9px;
  font-size: 27px;
  font-weight: bold;
  color: #176c50;
  cursor: pointer;
  background-color: #fafffc;
  background-image: radial-gradient(#25815f 4px, transparent 4.5px);
  background-size: 25px 25px;
}

.door:nth-child(3n) {
  background: repeating-linear-gradient(
    135deg, #147c59 0 12px, #218b67 12px 24px
  );
  color: white;
}

.door:nth-child(4n) {
  background-color: #acd2c0;
  background-image:
    linear-gradient(90deg,#d5eadf 50%,transparent 50%),
    linear-gradient(#d5eadf 50%,transparent 50%);
  background-size: 24px 24px;
}

.door:nth-child(5n) {
  grid-row: span 2;
}

.door:nth-child(7n) {
  grid-column: span 2;
}

.door:disabled {
  cursor: not-allowed;
  opacity: .65;
}

footer {
  text-align: center;
  color: #56836e;
  margin: 35px 0;
}

.modal {
  display: none;
  position: fixed;
  inset: 0;
  background: #0009;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal.show {
  display: flex;
}

.message {
  background: #fafffc;
  border-radius: 18px;
  padding: 30px 22px;
  width: 100%;
  max-width: 400px;
  text-align: center;
}

.message h2 {
  font-family: Georgia, serif;
}

.message button {
  background: #176c50;
  color: white;
  border: 0;
  border-radius: 8px;
  padding: 11px 25px;
  margin-top: 15px;
}
</style>
</head>

<body>

<header>
  <p>UN PEQUEÑO REGALO PARA TI</p>
  <h1>One day<br>a surprise</h1>
  <p>My destiny ♡</p>
  <p>24 días, 24 sorpresas especiales.</p>
</header>

<div class="grid" id="calendar"></div>

<footer>
  Hecho especialmente para My destiny ♡
</footer>

<div class="modal" id="modal">
  <div class="message">
    <h2 id="title"></h2>
    <p id="content"></p>
    <button onclick="closeDoor()">Cerrar</button>
  </div>
</div>

<script>
const year = 2026;

const surprises = [
"Un comienzo especial ♡",
"Un recuerdo bonito.",
"Una canción para ti.",
"Una pregunta especial.",
"Una pequeña carta.",
"Una fotografía.",
"Un acertijo: ¿qué tiene agujas y no cose?",
"Un mensaje para ti.",
"Una melodía especial.",
"Un recuerdo favorito.",
"Un pequeño desafío.",
"Una nota para ti.",
"Una foto especial.",
"Un acertijo: cuanto más quitas, más grande se vuelve.",
"Un deseo bonito.",
"Un audio para ti.",
"Tres cosas que admiro de ti.",
"Un instante especial.",
"Una sorpresa inesperada.",
"Un recuerdo en imágenes.",
"Una última adivinanza.",
"Una promesa.",
"Casi Navidad.",
"Feliz Navidad. Esta sorpresa es para ti. ♡"
];

const order = [
24,22,10,9,13,4,18,2,11,3,5,16,
23,14,19,8,12,21,17,6,1,7,15,20
];

const calendar = document.getElementById("calendar");

order.forEach(day => {
  const door = document.createElement("button");
  door.className = "door";
  door.textContent = day;

  const today = new Date();
  const available =
    today >= new Date(year, 11, day);

  door.disabled = !available;

  door.onclick = () => {
    document.getElementById("title").textContent =
      "Día " + day;

    document.getElementById("content").textContent =
      surprises[day - 1];

    document.getElementById("modal").classList.add("show");
  };

  calendar.appendChild(door);
});

function closeDoor() {
  document.getElementById("modal").classList.remove("show");
}
</script>

</body>
</html>
